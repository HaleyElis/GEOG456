library(httr2)
library(jsonlite)
library(dplyr)
library(janitor)
BASE_URL <- "https://lscluster.hockeytech.com/feed/index.php"
API_KEY <- "446521baf8c38984"
CLIENT_CODE <- "pwhl"
# ---------------------------
# Get one game PXP
# ---------------------------
get_pxp <- function(game_id) {
url <- paste0(
BASE_URL,
"?feed=gc",
"&tab=pxpverbose",
"&game_id=", game_id,
"&key=", API_KEY,
"&client_code=", CLIENT_CODE
)
txt <- request(url) |> req_perform() |> resp_body_string()
data <- fromJSON(txt, simplifyVector = FALSE)
rows <- data$GC$PXPVerbose
# 🔥 force clean (fix your main issue)
rows <- lapply(rows, function(r) {
lapply(r, function(v) {
if (is.null(v)) return(NA_character_)
paste(unlist(v), collapse = ", ")
})
})
df <- bind_rows(rows) |> clean_names()
return(df)
}
# ---------------------------
# Clean for your app
# ---------------------------
build_game <- function(game_id) {
df <- get_pxp(game_id)
df |>
mutate(
event = coalesce(event, description),
type = case_when(
grepl("GOAL", event, ignore.case = TRUE) ~ "goal",
grepl("SHOT", event, ignore.case = TRUE) ~ "shot",
TRUE ~ NA_character_
),
# 🔥 grab ANY x/y column
x = as.numeric(df[[grep("^x", names(df), value = TRUE)[1]]]),
y = as.numeric(df[[grep("^y", names(df), value = TRUE)[1]]])
) |>
filter(!is.na(type), !is.na(x), !is.na(y)) |>
transmute(
game_id = game_id,
period = as.numeric(period),
clock = time,
event_type = type,
x = x + 100,
y = y + 42.5
)
}
