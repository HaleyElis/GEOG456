library(httr2)
library(jsonlite)
library(dplyr)
library(janitor)
BASE_URL <- "https://lscluster.hockeytech.com/feed/index.php"
API_KEY <- "446521baf8c38984"
CLIENT_CODE <- "pwhl"
# ---------------------------
# Fetch raw PXP
# ---------------------------
get_pxp <- function(game_id) {
url <- paste0(
BASE_URL,
"?feed=gc",
"&tab=pxpverbose",
"&game_id=", game_id,
"&key=", API_KEY,
"&client_code=", CLIENT_CODE
)
txt <- request(url) |> req_perform() |> resp_body_string()
data <- fromJSON(txt, simplifyVector = FALSE)
rows <- data$GC$PXPVerbose
# flatten everything to character
rows <- lapply(rows, function(r) {
lapply(r, function(v) {
if (is.null(v)) return(NA_character_)
paste(unlist(v), collapse = ", ")
})
})
df <- bind_rows(rows) |> clean_names()
return(df)
}
# ---------------------------
# Build ONE game (clean)
# ---------------------------
build_game <- function(game_id) {
df <- get_pxp(game_id)
# 🔍 find actual x/y columns (no guessing names)
x_col <- names(df)[grep("^x", names(df))][1]
y_col <- names(df)[grep("^y", names(df))][1]
# 🔍 find event + time columns explicitly
event_col <- if ("event" %in% names(df)) "event" else names(df)[grep("event", names(df))][1]
time_col  <- if ("time" %in% names(df)) "time" else names(df)[grep("time", names(df))][1]
df$event_text <- df[[event_col]]
df$clock <- df[[time_col]]
df$type <- ifelse(
grepl("GOAL", df$event_text, ignore.case = TRUE), "goal",
ifelse(grepl("SHOT", df$event_text, ignore.case = TRUE), "shot", NA)
)
df$x <- as.numeric(df[[x_col]])
df$y <- as.numeric(df[[y_col]])
# keep only usable rows
df <- df[!is.na(df$type) & !is.na(df$x) & !is.na(df$y), ]
# final format for your HTML
out <- data.frame(
game_id = game_id,
period = as.numeric(df$period),
clock = df$clock,
event_type = df$type,
x = df$x + 100,
y = df$y + 42.5
)
return(out)
}
