# =========================================================
# CONFIG
# =========================================================
BASE_URL <- "https://lscluster.hockeytech.com/feed/index.php"
API_KEY <- "446521baf8c38984"
CLIENT_CODE <- "pwhl"
BDC_2022_URL <- "https://raw.githubusercontent.com/the-bucketless/bdc/main/data/pxp_womens_oly_2022_v2.csv"
dir.create("pwhl_games", showWarnings = FALSE)
dir.create("olympics_2022_games", showWarnings = FALSE)
# =========================================================
# HELPERS
# =========================================================
fetch_text <- function(url) {
request(url) |> req_perform() |> resp_body_string()
}
parse_json <- function(txt) {
tryCatch(
fromJSON(txt, simplifyVector = FALSE),
error = function(e) {
txt <- sub("^[^(]*\\(", "", txt)
txt <- sub("\\);?$", "", txt)
fromJSON(txt, simplifyVector = FALSE)
}
)
}
write_json_pretty <- function(x, path) {
write_json(x, path, pretty = TRUE, auto_unbox = TRUE)
}
safe_num <- function(x) suppressWarnings(as.numeric(x))
# 🔥 Flatten HockeyTech inconsistent rows
flatten_rows <- function(rows) {
lapply(rows, function(r) {
lapply(r, function(v) {
if (is.null(v) || length(v) == 0) return(NA_character_)
paste(as.character(unlist(v)), collapse = ", ")
})
})
}
# get first numeric x/y column (handles x...123)
get_xy <- function(df, prefix) {
cols <- names(df)[grepl(paste0("^", prefix), names(df))]
if (length(cols) == 0) return(rep(NA_real_, nrow(df)))
safe_num(df[[cols[1]]])
}
classify_event <- function(txt) {
txt <- toupper(txt)
case_when(
str_detect(txt, "GOAL") ~ "goal",
str_detect(txt, "SHOT") ~ "shot",
TRUE ~ NA_character_
)
}
# =========================================================
# PWHL
# =========================================================
get_seasons <- function() {
url <- paste0(BASE_URL,"?feed=modulekit&view=seasons&key=",API_KEY,"&client_code=",CLIENT_CODE)
parse_json(fetch_text(url))$SiteKit$Seasons |> bind_rows() |> clean_names()
}
get_schedule <- function(season_id) {
url <- paste0(BASE_URL,"?feed=modulekit&view=schedule&season_id=",season_id,"&key=",API_KEY,"&client_code=",CLIENT_CODE)
rows <- parse_json(fetch_text(url))$SiteKit$Schedule
if (is.null(rows)) return(tibble())
bind_rows(rows) |> clean_names() |> mutate(season_id = season_id)
}
get_pwhl_pxp <- function(game_id) {
url <- paste0(BASE_URL,"?feed=gc&tab=pxpverbose&game_id=",game_id,"&key=",API_KEY,"&client_code=",CLIENT_CODE)
rows <- parse_json(fetch_text(url))$GC$PXPVerbose
if (is.null(rows)) return(tibble())
rows <- flatten_rows(rows)
bind_rows(rows) |> clean_names()
}
build_schedule <- function() {
seasons <- get_seasons()
map_dfr(seasons$season_id, get_schedule) |>
distinct(game_id, .keep_all = TRUE) |>
mutate(
game_date = substr(coalesce(date_played, date),1,10),
home_team = coalesce(home_team_name, home_team),
away_team = coalesce(visiting_team_name, visiting_team),
label = paste0(game_date," — ",away_team," @ ",home_team)
)
}
build_game <- function(game_id, row) {
df <- get_pwhl_pxp(game_id)
if (nrow(df)==0) return(tibble())
df |>
mutate(
event = coalesce(event, description),
type = classify_event(event),
x = get_xy(df,"x"),
y = get_xy(df,"y"),
period = as.numeric(period),
clock = as.character(time),
team = coalesce(team, team_name),
team_side = ifelse(team==row$home_team,"home","away")
) |>
filter(!is.na(type), !is.na(x), !is.na(y)) |>
transmute(
game_id,
game_date = row$game_date,
home_team = row$home_team,
away_team = row$away_team,
period,
clock,
team,
team_side,
event_text = event,
event_type = type,
x = round(x+100,2),
y = round(y+42.5,2)
)
}
export_pwhl <- function() {
schedule <- build_schedule()
write_json_pretty(schedule,"pwhl_schedule.json")
for(i in 1:nrow(schedule)){
row <- schedule[i,]
game <- build_game(row$game_id, row)
write_json_pretty(game, paste0("pwhl_games/game_",row$game_id,".json"))
}
schedule
}
# =========================================================
# BDC 2022
# =========================================================
export_bdc <- function() {
df <- read_csv(BDC_2022_URL, show_col_types = FALSE) |> clean_names()
df <- df |>
mutate(
game_date = substr(game_date,1,10),
team = coalesce(team_name, team),
opp = coalesce(opp_team_name, opponent),
game_id = paste(game_date, pmin(team,opp), pmax(team,opp))
)
schedule <- df |>
distinct(game_id, game_date, team, opp) |>
rename(home_team = team, away_team = opp)
write_json_pretty(schedule,"olympics_2022_schedule.json")
for(i in 1:nrow(schedule)){
row <- schedule[i,]
game <- df |>
filter(game_id==row$game_id) |>
mutate(
type = classify_event(event),
x = get_xy(., "x"),
y = get_xy(., "y")
) |>
filter(!is.na(type), !is.na(x), !is.na(y))
write_json_pretty(game, paste0("olympics_2022_games/game_",row$game_id,".json"))
}
schedule
}
# =========================================================
# RUN
# =========================================================
pwhl <- export_pwhl()
bdc  <- export_bdc()
rlang::last_trace()
rlang::last_trace(drop = FALSE)
