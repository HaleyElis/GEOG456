mutate(
type = classify_event(event),
x = get_xy(., "x"),
y = get_xy(., "y")
) |>
filter(!is.na(type), !is.na(x), !is.na(y))
write_json_pretty(game, paste0("olympics_2022_games/game_",row$game_id,".json"))
}
schedule
}
